# Copy to .env, fill in your credentials and Docker Hub namespace, and keep it private.
# Generate a password with: openssl rand -hex 32
DB_PASSWORD=replace-with-a-long-random-password
CONNEXIS_BASE_URL=https://connexis.example.com
# Exact Authorization header value; include Bearer only if the provider requires it.
# Single quotes preserve dollar signs and # characters in Docker Compose .env files.
CONNEXIS_API_TOKEN='replace-with-your-exact-authorization-header'

TRACCAR_IMAGE=traccar/traccar:6.17.0-alpine
# Matches the guide; pin to a tested version/digest for controlled database upgrades.
DATABASE_IMAGE=timescale/timescaledb:latest-pg17
# Your Docker Hub username or organization/workspace (lowercase).
DOCKERHUB_NAMESPACE=your-dockerhub-username
DOCKER_REGISTRY=docker.io
ADAPTER_IMAGE_NAME=traccar-connexis-adapter
# Use a new tag for each release. The push script and production Compose share it.
ADAPTER_IMAGE_TAG=1.0.0
# Publish for common Linux servers and ARM machines. Development builds are native.
BUILD_PLATFORMS=linux/amd64,linux/arm64

# Production uses your existing Traefik setup; no host ports are published.
TRACCAR_DOMAIN=traccar.zeeit.dev
# Host folders for the database and Traccar logs/data only.
# Adapter state uses the Docker-managed adapter_state named volume.
TRACCAR_VOLUME_ROOT=/home/zeeshan/containers/volumes/traccar

# Development only (compose.dev.yml): local dashboard access.
TRACCAR_BIND_ADDRESS=127.0.0.1
TRACCAR_WEB_PORT=8082

CONNEXIS_ASSETS_PATH=/api/v1/assets/
CONNEXIS_LOCATIONS_PATH=/api/v1/current_location
# Empty discovers all vehicles. Otherwise comma-separated identifiers, e.g. APL-04.
# Explicit plates skip discovery and restrict which returned positions are forwarded.
CONNEXIS_PLATES=

# Total API attempts across discovery, location polling, and manual commands.
# Request spacing is calculated as 60 / this value, with a shared rolling quota.
# Polling is automatic: 1 request/cycle with explicit plates, 2 with discovery.
CONNEXIS_REQUESTS_PER_MINUTE=3
# Retry ceiling in seconds; must be at least the calculated polling interval.
MAX_BACKOFF=300
REQUEST_TIMEOUT=20
# Applies only to timestamps without an explicit timezone; verify with Connexis.
GPS_UTC_OFFSET=+05:00
# Provider's input speed unit: kmh, mph, mps, or knots. Verify with Connexis.
SPEED_UNIT=kmh
VERIFY_TLS=true
# Health means a successful API/forwarding cycle, not a fresh GPS fix.
HEALTH_MAX_AGE=600
